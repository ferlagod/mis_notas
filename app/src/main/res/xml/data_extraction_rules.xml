<!--
  Android 12+:
  - Copia en la nube: desactivada (las notas locales no están cifradas).
  - Transferencia directa entre dispositivos (cable / Wi-Fi local): se copian notas y adjuntos,
    pero no las credenciales, que dependen del Keystore del dispositivo de origen.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="attachments/" />
    </device-transfer>
</data-extraction-rules>
